{
 "Lekce zdarma: 1.1 Co je nemoc · Život vysvětlen": "title",
 "1.1 · Co je nemoc": "h1",
 "Dvanáct základů, na kterých to celé stojí": "h2",
 "Vnitřní a vnější terén": "h2",
 "Dvě příčiny": "h2",
 "Zátěž: co je navíc": "h2",
 "Nedostatek: co chybí": "h2",
 "Symptom je strategie": "h2",
 "Kudy to jde ven": "h2",
 "Dva směry čištění": "h2",
 "Přestavba": "h2",
 "Přesvědčení, která stojí za přehodnocení": "h2",
 "Shrnutí": "h2",
 "Tvoje výzva": "h2",
 "Tohle byla jedna ze 102 lekcí": "h2",
 "Jak je to s dávkou": "h3",
 "Proč se nedá uzdravit bez odlehčení": "h3",
 "Slunce jako živina": "h3",
 "Celé jídlo": "h3",
